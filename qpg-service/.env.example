# --- Login check (same Supabase project as the admin panel) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional: only needed if your `users` table doesn't let a logged-in
# user read their own row. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Roles allowed to use the service (comma separated)
QPG_ALLOWED_ROLES=admin
# Your admin panel's address, e.g. https://atlasclasses.vercel.app
QPG_ALLOWED_ORIGINS=*

# --- AI provider keys (stay on the server, never sent to the browser) ---
# Fill in the ones you use; the admin panel only offers configured ones.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
# OMNIROUTE_BASE_URL=http://your-omniroute-host:20128/

# Max upload size in MB
QPG_MAX_UPLOAD_MB=50
